# Copy to .env for local development. On Vercel, set these under
# Project → Settings → Environment Variables instead. Never commit .env.
#
# ALL OF THESE ARE SERVER-SIDE ONLY. Read by the functions in api/, never by
# the React app.
#
# DO NOT PREFIX ANY OF THEM WITH VITE_. Vite copies every VITE_ variable into
# the JavaScript sent to the browser — that is how the internal app's anon key
# became public. A VITE_SUPABASE_SERVICE_ROLE_KEY would hand every visitor full
# database access. vite.config.js refuses to build if one exists.

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay — TEST MODE keys until Phase 4 passes (replay, forge, double-click).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
