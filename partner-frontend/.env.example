# Copy to .env for local development. On Vercel, set these under
# Project → Settings → Environment Variables instead. Never commit .env.
#
# ALL OF THESE ARE SERVER-SIDE ONLY. Read by the functions in api/, never by
# the React app.
#
# DO NOT PREFIX ANY OF THEM WITH VITE_. Vite copies every VITE_ variable into
# the JavaScript sent to the browser — that is how the internal app's anon key
# became public. A VITE_SUPABASE_SERVICE_ROLE_KEY would hand every visitor full
# database access. vite.config.js refuses to build if one exists.

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Postgres, for the fofo schema (not reachable through supabase-js — see
# api/_lib/db.js). Supabase → Connect → TRANSACTION pooler, port 6543, with the
# database password filled in.
DATABASE_URL=
# Supabase's CA certificate (Database settings → SSL configuration → Download
# certificate), pasted whole. Without it the connection is encrypted but the
# server's certificate is not verified.
DATABASE_CA_CERT=

# Email, through Resend (api/_lib/email.js). The key needs "Sending access".
# While EMAIL_FROM is Resend's test sender, mail is delivered only to the
# address the Resend account was registered with.
RESEND_API_KEY=
EMAIL_FROM=Gastronomix <onboarding@resend.dev>

# This app's public address. Registration links are built from it, never from
# the request. Not secret. Locally: http://localhost:5174
PARTNER_APP_URL=

# Origins of the internal app, comma-separated, allowed to call /api/admin from
# a browser. Not secret. Locally the internal app runs on http://localhost:5173.
INTERNAL_APP_ORIGINS=http://localhost:5173

# Razorpay — TEST MODE keys until Phase 4 passes (replay, forge, double-click).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
